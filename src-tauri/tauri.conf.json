{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuantDesk",
  "version": "0.3.5",
  "identifier": "com.quantdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "QuantDesk",
      "width": 1380,
      "height": 900,
      "minWidth": 960,
      "minHeight": 680,
      "center": true,
      "resizable": true,
      "fullscreen": false,
      "decorations": false,
      "shadow": true
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 http://localhost:1420 ws://127.0.0.1:1420 ws://localhost:1420; img-src 'self' asset: data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../engine": "engine",
      "../engine-dist/quant-engine.exe": "engine-bin/quant-engine.exe"
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
